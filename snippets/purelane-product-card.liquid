{% comment %}
  Purelane product card. Price, availability, and media come from Shopify.
  Accepts: product, card_badge, custom_class, delay_class
{% endcomment %}

{%- liquid
  assign rating = product.metafields.custom.rating.value
  assign reviews_count = product.metafields.custom.reviews_count.value
  if rating == blank or reviews_count == blank
    for tag in product.tags
      if rating == blank and tag contains 'rating:'
        assign rating = tag | split: ':' | last | strip
      endif
      if reviews_count == blank and tag contains 'reviews:'
        assign reviews_count = tag | split: ':' | last | strip
      endif
    endfor
  endif

  assign badge = card_badge
  if badge == blank
    assign badge = product.metafields.custom.badge.value
  endif
  if badge == blank
    for tag in product.tags
      if tag contains 'badge:'
        assign badge = tag | split: ':' | last | strip
        break
      endif
    endfor
  endif
  if badge == blank and product.available == false
    assign badge = 'Sold out'
  endif

  assign product_alt = product.title | escape
-%}

<article class="glass card rv {{ delay_class }} {% unless product.available %}sold-out{% endunless %} {{ custom_class }}" data-product-id="{{ product.id }}">
  <div class="shot">
    {%- if badge != blank -%}
      <span class="pill">{{ badge | escape }}</span>
    {%- endif -%}
    <a href="{{ product.url }}" class="purelane-shot-link" aria-label="{{ product_alt }}">
      {% render 'purelane-product-art', product: product %}
    </a>
  </div>

  <h4 title="{{ product_alt }}">
    <a href="{{ product.url }}">{{ product.title | escape }}</a>
  </h4>

  {%- if rating != blank -%}
    <div class="rate">
      <b>★ {{ rating | escape }}</b>
      {%- if reviews_count != blank -%}
        · {{ reviews_count | escape }} reviews
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="pr">
    <strong>{% render 'purelane-money', amount: product.price %}</strong>
    {%- if product.compare_at_price > product.price -%}
      <s>{% render 'purelane-money', amount: product.compare_at_price %}</s>
      {%- assign savings = product.compare_at_price | minus: product.price -%}
      {%- assign discount = savings | times: 100.0 | divided_by: product.compare_at_price | round -%}
      <em>{{ discount }}% off</em>
    {%- endif -%}
  </div>

  {%- if product.available -%}
    <button
      type="button"
      class="btn btn-ghost btn-sm purelane-add-to-cart-btn"
      data-variant-id="{{ product.selected_or_first_available_variant.id }}"
      aria-label="Add {{ product_alt }} to cart"
    >
      Add to cart
    </button>
  {%- else -%}
    <button type="button" class="btn btn-ghost btn-sm" disabled aria-disabled="true" aria-label="{{ product_alt }} is sold out">
      Sold out
    </button>
  {%- endif -%}
</article>
