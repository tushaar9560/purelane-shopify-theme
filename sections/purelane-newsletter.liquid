<!-- ================= SIGNUP ================= -->
<section class="sec" data-scene="4">
  <div class="wrap">
    <div class="glass signup rv">
      <span class="kicker">{{ section.settings.kicker | default: 'Join the Purelane Club' }}</span>
      <h2 class="d2" style="margin-top:12px">{{ section.settings.heading | default: 'Get ₹100 off your first bundle' }}</h2>
      <p class="lede" style="margin:0 auto">{{ section.settings.lede | default: 'Plus first access to new launches and restocks.' }}</p>

      {%- form 'customer', class: 'purelane-signup-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {%- if form.posted_successfully? -%}
          <p style="color:var(--accent);margin-top:16px;font-weight:600;">Thank you for joining! Check your inbox for your ₹100 discount code.</p>
        {%- else -%}
          <div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-top:20px;">
            <input 
              type="email" 
              name="contact[email]" 
              placeholder="your@email.com" 
              aria-label="Email address" 
              value="{{ form.email }}"
              required
              style="padding:12px 18px;border-radius:999px;border:1px solid rgba(236,230,247,.24);background:rgba(23,16,43,.4);color:#fff;font-family:inherit;font-size:14px;min-width:260px;">
            <button class="btn btn-primary" type="submit">{{ section.settings.button_text | default: 'Get my ₹100 off' }}</button>
          </div>
          {%- if form.errors -%}
            <small style="color:#ff6b6b;display:block;margin-top:8px;">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</small>
          {%- endif -%}
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Join the Purelane Club"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get ₹100 off your first bundle"
    },
    {
      "type": "text",
      "id": "lede",
      "label": "Lede",
      "default": "Plus first access to new launches and restocks."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Label",
      "default": "Get my ₹100 off"
    }
  ],
  "presets": [
    {
      "name": "Purelane Newsletter"
    }
  ]
}
{% endschema %}
