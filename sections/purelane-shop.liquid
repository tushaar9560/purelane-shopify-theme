<section class="sec" id="shop" data-scene="3">
  <div class="wrap">
    <div class="panel-head rv">
      <span class="kicker">{{ section.settings.kicker | default: 'Bestsellers' }}</span>
      <h2 class="d2" style="margin-top:12px">{{ section.settings.heading | default: 'Loved by 30,000 homes' }}</h2>
      <div class="rule">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
          <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
        </svg>
        <i></i>
      </div>
    </div>

    <div class="shelf">
      {%- assign current_collection = section.settings.collection -%}
      {%- if current_collection != blank and current_collection.products_count > 0 -%}
        {%- for product in current_collection.products limit: section.settings.products_to_show -%}
          {%- capture delay_class -%}rv-d{{ forloop.index | modulo: 4 }}{%- endcapture -%}
          {% render 'purelane-product-card', product: product, delay_class: delay_class %}
        {%- endfor -%}
      {%- elsif collections.all.products_count > 0 -%}
        {%- for product in collections.all.products limit: section.settings.products_to_show -%}
          {%- capture delay_class -%}rv-d{{ forloop.index | modulo: 4 }}{%- endcapture -%}
          {% render 'purelane-product-card', product: product, delay_class: delay_class %}
        {%- endfor -%}
      {%- else -%}
        {%- comment -%}Fallback initial prototype showcase if no products exist yet{%- endcomment -%}
        <article class="glass card rv">
          <div class="shot"><span class="pill">Best seller</span><span class="pimg p-tap" role="img" aria-label="Tap cleaner"></span></div>
          <h4>Tap cleaner &amp; limescale remover</h4>
          <div class="rate"><b>★ 4.8</b> · 237 reviews</div>
          <div class="pr"><strong>₹200</strong><s>₹299</s><em>33% off</em></div>
          <button class="btn btn-ghost btn-sm">Add to cart</button>
        </article>
        <article class="glass card rv rv-d1">
          <div class="shot"><span class="pill">Best seller</span><span class="pimg p-kitchen" role="img" aria-label="Kitchen cleaner"></span></div>
          <h4>Kitchen cleaner, foaming</h4>
          <div class="rate"><b>★ 4.8</b> · 254 reviews</div>
          <div class="pr"><strong>₹200</strong><s>₹299</s><em>33% off</em></div>
          <button class="btn btn-ghost btn-sm">Add to cart</button>
        </article>
        <article class="glass card rv rv-d2">
          <div class="shot"><span class="pill">Top rated</span><span class="pimg p-metal" role="img" aria-label="Copper, bronze cleaner"></span></div>
          <h4>Copper, bronze &amp; brass cleaner</h4>
          <div class="rate"><b>★ 4.8</b> · 231 reviews</div>
          <div class="pr"><strong>₹200</strong><s>₹299</s><em>33% off</em></div>
          <button class="btn btn-ghost btn-sm">Add to cart</button>
        </article>
        <article class="glass card rv rv-d3">
          <div class="shot"><span class="pill">New</span><span class="pimg p-wm" role="img" aria-label="Washing machine cleaner"></span></div>
          <h4>Washing machine cleaner &amp; descaler</h4>
          <div class="rate"><b>★ 4.8</b> · 183 reviews</div>
          <div class="pr"><strong>₹200</strong><s>₹299</s><em>33% off</em></div>
          <button class="btn btn-ghost btn-sm">Add to cart</button>
        </article>
      {%- endif -%}
    </div>
  </div>
  {% comment %} #region agent log {% endcomment %}
  <script>
    (function () {
      var shop = document.getElementById('shop');
      var text = shop ? shop.innerText || '' : '';
      fetch('http://127.0.0.1:7317/ingest/54be5e12-6d21-4405-a65a-d0ddbbeea765', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-Debug-Session-Id': '47304c' },
        body: JSON.stringify({
          sessionId: '47304c',
          runId: 'post-fix',
          hypothesisId: 'A',
          location: 'sections/purelane-shop.liquid',
          message: 'shop grid snippet probe',
          timestamp: Date.now(),
          data: {
            hasMissingSnippetError: text.indexOf('Could not find asset') !== -1,
            cardCount: shop ? shop.querySelectorAll('article.card').length : 0,
            catalogCount: {{ collections.all.products_count | default: 0 }},
          },
        }),
      }).catch(function () {});
    })();
  </script>
  {% comment %} #endregion {% endcomment %}
</section>

{% schema %}
{
  "name": "Purelane Shop Grid",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Bestsellers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by 30,000 homes"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 16,
      "step": 2,
      "default": 8,
      "label": "Products to show"
    }
  ],
  "presets": [
    {
      "name": "Purelane Shop Grid"
    }
  ]
}
{% endschema %}
