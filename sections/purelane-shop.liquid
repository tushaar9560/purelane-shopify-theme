<section class="sec" id="shop" data-scene="3">
  <div class="wrap">
    <div class="panel-head rv">
      <span class="kicker">{{ section.settings.kicker }}</span>
      <h2 class="d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
      <div class="rule">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
          <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
        </svg>
        <i></i>
      </div>
    </div>

    {%- if section.settings.collection != blank and section.settings.collection.products_count > 0 -%}
      <div class="shelf">
        {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
          {%- capture delay_class -%}rv-d{{ forloop.index | modulo: 4 }}{%- endcapture -%}
          {% render 'purelane-product-card', product: product, delay_class: delay_class %}
        {%- endfor -%}
      </div>
    {%- elsif collections.all.products_count > 0 -%}
      <div class="shelf">
        {%- for product in collections.all.products limit: section.settings.products_to_show -%}
          {%- capture delay_class -%}rv-d{{ forloop.index | modulo: 4 }}{%- endcapture -%}
          {% render 'purelane-product-card', product: product, delay_class: delay_class %}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="purelane-empty">Add products to the store, or choose a collection in the theme editor, to fill this shelf.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Purelane Shop Grid",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Bestsellers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by 30,000 homes"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Leave empty to show products from the whole catalog."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 50,
      "step": 1,
      "default": 8,
      "label": "Products to show"
    }
  ],
  "presets": [
    {
      "name": "Purelane Shop Grid"
    }
  ]
}
{% endschema %}
