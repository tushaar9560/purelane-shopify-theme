          "default": "Products"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "₹499"
        },
        {
          "type": "text",
          "id": "compare_price",
          "label": "Compare Price",
          "default": "₹897"
        },
        {
          "type": "text",
          "id": "rate_note",
          "label": "Per Product Note",
          "default": "Flat ₹166 per product"
        },
        {
          "type": "text",
          "id": "feature_1",
          "label": "Benefit 1",
          "default": "Pick any three products"
        },
        {
          "type": "text",
          "id": "feature_2",
          "label": "Benefit 2",
          "default": "Covers kitchen and laundry"
        },
        {
          "type": "text",
          "id": "feature_3",
          "label": "Benefit 3",
          "default": "Free shipping across India"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Label",
          "default": "Build this box"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        },
        {
          "type": "text",
          "id": "delay_class",
          "label": "Reveal Delay Class",
          "default": "rv-d1"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Bundles",
      "blocks": [
        {
          "type": "tier",
          "settings": {
