<section class="sec" id="bundles" data-scene="3">
  <div class="wrap">
    <div class="glass sec-pad rv" style="margin-bottom:16px">
      <div class="panel-head" style="margin-bottom:0">
        <span class="kicker">{{ section.settings.kicker }}</span>
        <h2 class="d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
        {%- if section.settings.lede != blank -%}
          <p class="lede" style="margin:0 auto">{{ section.settings.lede }}</p>
        {%- endif -%}
      </div>
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="tiers">
        {%- for block in section.blocks -%}
          {%- liquid
            assign preview_products = block.settings.products
            assign preview_count = 0
            assign compare_total = 0
            if preview_products != blank
              assign preview_count = preview_products.size
              for product in preview_products
                if product.compare_at_price > product.price
                  assign compare_total = compare_total | plus: product.compare_at_price
                else
                  assign compare_total = compare_total | plus: product.price
                endif
              endfor
            endif

            assign qty = preview_count
            if block.settings.product_count != blank
              assign qty = block.settings.product_count | times: 1
            endif
            if qty == 0
              assign qty = preview_count
            endif

            assign sale_price = compare_total
            if block.settings.bundle_price != blank
              assign override_rupees = block.settings.bundle_price | replace: '₹', '' | replace: ',', '' | replace: ' ', ''
              if override_rupees != blank
                assign sale_price = override_rupees | times: 100
              endif
            endif
            assign per_product = 0
            if qty > 0 and sale_price > 0
              assign per_product = sale_price | times: 1.0 | divided_by: qty | round
            endif
          -%}
          <article class="glass tier {% if block.settings.is_featured %}featured{% endif %} rv" {{ block.shopify_attributes }}>
            {%- if block.settings.tag != blank -%}
              <span class="tag">{{ block.settings.tag | escape }}</span>
            {%- endif -%}
            {%- if preview_count > 0 -%}
              <div class="tierpix {% if preview_count >= 5 %}five{% endif %}" aria-hidden="true">
                {%- for product in preview_products -%}
                  {% render 'purelane-product-art', product: product %}
                {%- endfor -%}
              </div>
            {%- endif -%}
            {%- if qty > 0 -%}
              <div class="qty">{{ qty }}<small>{% if qty == 1 %}Product{% else %}Products{% endif %}</small></div>
            {%- endif -%}
            {%- if sale_price > 0 -%}
              <div class="price">
                {% render 'purelane-money', amount: sale_price %}
                {%- if compare_total > sale_price -%}
                  <s>{% render 'purelane-money', amount: compare_total %}</s>
                {%- endif -%}
              </div>
            {%- endif -%}
            {%- if block.settings.rate_note != blank -%}
              <p class="body-s" style="font-size:12px">{{ block.settings.rate_note | escape }}</p>
            {%- elsif per_product > 0 -%}
              <p class="body-s" style="font-size:12px">Flat {% render 'purelane-money', amount: per_product %} per product</p>
            {%- endif -%}
            <ul>
              {%- if block.settings.feature_1 != blank -%}
                <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg>{{ block.settings.feature_1 | escape }}</li>
              {%- endif -%}
              {%- if block.settings.feature_2 != blank -%}
                <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg>{{ block.settings.feature_2 | escape }}</li>
              {%- endif -%}
              {%- if block.settings.feature_3 != blank -%}
                <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg>{{ block.settings.feature_3 | escape }}</li>
              {%- endif -%}
            </ul>
            <a class="btn {% if block.settings.is_featured %}btn-primary{% else %}btn-ghost{% endif %}" href="{{ block.settings.button_link | default: '#shop' }}">
              {{ block.settings.button_text | default: 'Build this box' | escape }}
              {%- if block.settings.is_featured -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
              {%- endif -%}
            </a>
          </article>
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="purelane-empty">Add bundle tiers in the theme editor. Pick preview products to pull live prices, or set a sale price for mix-and-match boxes.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Purelane Bundles",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Build your bundle"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "One box. Every room."
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Lede description",
      "default": "Mix and match across kitchen, laundry, home and skin. One flat price, no code needed, free shipping either way."
    }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Bundle Tier",
      "settings": [
        {
          "type": "checkbox",
          "id": "is_featured",
          "label": "Featured tier",
          "default": false
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Badge tag",
          "default": "Starter"
        },
        {
          "type": "product_list",
          "id": "products",
          "label": "Preview products",
          "limit": 12,
          "info": "Used for bottle art and the compare-at total. The sale price can still be a mix-and-match offer."
        },
        {
          "type": "number",
          "id": "product_count",
          "label": "How many products in this box",
          "info": "Used for mix-and-match copy. Leave empty to use the number of preview products."
        },
        {
          "type": "text",
          "id": "bundle_price",
          "label": "Sale price",
          "info": "Optional offer total in the store currency, e.g. 499. Leave blank to use the sum of preview product prices."
        },
        {
          "type": "text",
          "id": "rate_note",
          "label": "Per-product note override"
        },
        {
          "type": "text",
          "id": "feature_1",
          "label": "Benefit 1",
          "default": "Pick any two products"
        },
        {
          "type": "text",
          "id": "feature_2",
          "label": "Benefit 2",
          "default": "Free shipping across India"
        },
        {
          "type": "text",
          "id": "feature_3",
          "label": "Benefit 3"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button label",
          "default": "Build this box"
        },
        {
          "type": "text",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Bundles",
      "blocks": [
        {
          "type": "tier",
          "settings": {
            "tag": "Starter",
            "product_count": 2,
            "bundle_price": "349",
            "feature_1": "Pick any two products",
            "feature_2": "Free shipping across India"
          }
        },
        {
          "type": "tier",
          "settings": {
            "is_featured": true,
            "tag": "Most popular",
            "product_count": 3,
            "bundle_price": "499",
            "feature_1": "Pick any three products",
            "feature_2": "Covers kitchen and laundry",
            "feature_3": "Free shipping across India"
          }
        },
        {
          "type": "tier",
          "settings": {
            "tag": "Whole home",
            "product_count": 5,
            "bundle_price": "799",
            "feature_1": "Pick any five products",
            "feature_2": "Every room in one order",
            "feature_3": "Free shipping across India"
          }
        }
      ]
    }
  ]
}
{% endschema %}
