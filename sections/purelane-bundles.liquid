            "delay_class": ""
          }
        },
        {
          "type": "tier",
          "settings": {
            "is_featured": true,
            "tag": "Most popular",
            "pix_count": "3",
            "product_count": "3",
            "price": "₹499",
            "compare_price": "₹897",
            "rate_note": "Flat ₹166 per product",
