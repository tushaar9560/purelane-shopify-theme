<section class="sec" id="combos" data-scene="3">
  <div class="wrap">
    <div class="panel-head rv">
      <span class="kicker">{{ section.settings.kicker | default: 'Pre-built to save you money' }}</span>
      <h2 class="d2" style="margin-top:12px">{{ section.settings.heading | default: 'Best selling combos' }}</h2>
      <div class="rule">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
          <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
        </svg>
        <i></i>
      </div>
      <p class="lede" style="margin:14px auto 0">{{ section.settings.lede | default: 'Swipe through the boxes people order most. Each one is already priced below buying the same products on their own.' }}</p>
    </div>

    <div class="comborail rv">
      {%- for block in section.blocks -%}
        <article class="glass combo {% if block.settings.is_hero %}hero-combo{% endif %}" {{ block.shopify_attributes }}>
          <div class="tray">
            {%- if block.settings.save_badge != blank -%}
              <span class="save">{{ block.settings.save_badge }}</span>
            {%- endif -%}
            {%- if block.settings.flag != blank -%}
              <span class="flag">{{ block.settings.flag }}</span>
            {%- endif -%}
            <div class="stack">
              {%- if block.settings.benefit1 != blank -%}
                <span class="it">
                  <span class="pimg {{ block.settings.img1_class | default: 'p-kitchen' }}" role="img" aria-label="{{ block.settings.benefit1 }}"></span>
                  <span>{{ block.settings.benefit1 }}</span>
                </span>
              {%- endif -%}
              {%- if block.settings.benefit2 != blank -%}
                <span class="plus" aria-hidden="true">+</span>
                <span class="it">
                  <span class="pimg {{ block.settings.img2_class | default: 'p-dish' }}" role="img" aria-label="{{ block.settings.benefit2 }}"></span>
                  <span>{{ block.settings.benefit2 }}</span>
                </span>
              {%- endif -%}
              {%- if block.settings.benefit3 != blank -%}
                <span class="plus" aria-hidden="true">+</span>
                <span class="it">
                  <span class="pimg {{ block.settings.img3_class | default: 'p-tap' }}" role="img" aria-label="{{ block.settings.benefit3 }}"></span>
                  <span>{{ block.settings.benefit3 }}</span>
                </span>
              {%- endif -%}
            </div>
          </div>

          <div class="body">
            <h3>{{ block.settings.title }}</h3>
            <div class="cnt">{{ block.settings.count_text }}</div>
            <p class="inc">{{ block.settings.includes_text }}</p>
            <div class="prow">
              <strong>{{ block.settings.price }}</strong>
              <s>{{ block.settings.compare_price }}</s>
              <em>{{ block.settings.discount_pill }}</em>
            </div>
            <div class="fine">Inclusive of all taxes &middot; COD available</div>
            <a class="btn {% if block.settings.is_hero %}btn-primary{% else %}btn-ghost{% endif %}" href="{{ block.settings.button_url | default: '#bundles' }}">
              Shop bundle
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h13m-5-6 6 6-6 6"/>
              </svg>
            </a>
          </div>
        </article>
      {%- endfor -%}
    </div>

    <div class="swipecue" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
      Swipe for more combos
    </div>
    <p class="railnote">{{ section.settings.railnote | default: 'Tapping "Shop bundle" opens the bundle picker with these products already added. You can still swap anything before you pay.' }}</p>
  </div>
</section>

