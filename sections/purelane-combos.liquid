<section class="sec" id="combos" data-scene="3">
  <div class="wrap">
    <div class="panel-head rv">
      <span class="kicker">{{ section.settings.kicker }}</span>
      <h2 class="d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
      <div class="rule">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
          <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
        </svg>
        <i></i>
      </div>
      {%- if section.settings.lede != blank -%}
        <p class="lede" style="margin:14px auto 0">{{ section.settings.lede }}</p>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="comborail rv">
        {%- for block in section.blocks -%}
          {%- liquid
            assign combo_products = block.settings.products
            assign combo_count = 0
            assign price_total = 0
            assign compare_total = 0
            assign variant_ids = ''
            assign include_names = ''
            if combo_products != blank
              assign combo_count = combo_products.size
              for product in combo_products
                assign price_total = price_total | plus: product.price
                if product.compare_at_price > product.price
                  assign compare_total = compare_total | plus: product.compare_at_price
                else
                  assign compare_total = compare_total | plus: product.price
                endif
                if product.available and product.selected_or_first_available_variant
                  if variant_ids == blank
                    assign variant_ids = product.selected_or_first_available_variant.id
                  else
                    assign variant_ids = variant_ids | append: ',' | append: product.selected_or_first_available_variant.id
                  endif
                endif
                if include_names == blank
                  assign include_names = product.title
                else
                  assign include_names = include_names | append: ', ' | append: product.title
                endif
              endfor
            endif

            assign sale_price = price_total
            if block.settings.bundle_price != blank
              assign override_rupees = block.settings.bundle_price | replace: '₹', '' | replace: ',', '' | replace: ' ', ''
              if override_rupees != blank
                assign sale_price = override_rupees | times: 100
              endif
            endif
            assign savings = 0
            if compare_total > sale_price
              assign savings = compare_total | minus: sale_price
            endif
          -%}

          <article class="glass combo {% if block.settings.is_hero %}hero-combo{% endif %}" {{ block.shopify_attributes }}>
            <div class="tray">
              {%- if savings > 0 -%}
                <span class="save">
                  {%- if block.settings.save_badge != blank -%}
                    {{ block.settings.save_badge | escape }}
                  {%- else -%}
                    You save {{ savings | money_without_trailing_zeros }}
                  {%- endif -%}
                </span>
              {%- elsif block.settings.save_badge != blank -%}
                <span class="save">{{ block.settings.save_badge | escape }}</span>
              {%- endif -%}
              {%- if block.settings.flag != blank -%}
                <span class="flag">{{ block.settings.flag | escape }}</span>
              {%- endif -%}
              <div class="stack">
                {%- if combo_count > 0 -%}
                  {%- for product in combo_products -%}
                    {%- unless forloop.first -%}
                      <span class="plus" aria-hidden="true">+</span>
                    {%- endunless -%}
                    <span class="it">
                      {% render 'purelane-product-art', product: product %}
                      <span>
                        {%- if product.metafields.custom.key_benefit.value != blank -%}
                          {{ product.metafields.custom.key_benefit.value | escape }}
                        {%- else -%}
                          {{ product.title | escape }}
                        {%- endif -%}
                      </span>
                    </span>
                  {%- endfor -%}
                {%- endif -%}
              </div>
            </div>
            <div class="body">
              <h3>{{ block.settings.title | escape }}</h3>
              {%- if combo_count > 0 -%}
                <div class="cnt">{{ combo_count }} {% if combo_count == 1 %}product{% else %}products{% endif %}</div>
              {%- endif -%}
              {%- if block.settings.includes_text != blank -%}
                <p class="inc">{{ block.settings.includes_text | escape }}</p>
              {%- elsif include_names != blank -%}
                <p class="inc">Includes: {{ include_names | escape }}.</p>
              {%- endif -%}
              {%- if combo_count > 0 -%}
                <div class="prow">
                  <strong>{{ sale_price | money_without_trailing_zeros }}</strong>
                  {%- if compare_total > sale_price -%}
                    <s>{{ compare_total | money_without_trailing_zeros }}</s>
                    <em>Save {{ savings | money_without_trailing_zeros }}</em>
                  {%- endif -%}
                </div>
              {%- endif -%}
              {%- if section.settings.fine_print != blank -%}
                <div class="fine">{{ section.settings.fine_print | escape }}</div>
              {%- endif -%}
              {%- if variant_ids != blank -%}
                <button
                  type="button"
                  class="btn {% if block.settings.is_hero %}btn-primary{% else %}btn-ghost{% endif %} purelane-add-to-cart-btn"
                  data-items="{{ variant_ids }}"
                  aria-label="Add {{ block.settings.title | escape }} to cart"
                >
                  Shop bundle
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
                </button>
              {%- elsif block.settings.button_url != blank -%}
                <a class="btn {% if block.settings.is_hero %}btn-primary{% else %}btn-ghost{% endif %}" href="{{ block.settings.button_url }}">
                  Shop bundle
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
                </a>
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      </div>
      <div class="swipecue" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
        Swipe for more combos
      </div>
      {%- if section.settings.railnote != blank -%}
        <p class="railnote">{{ section.settings.railnote }}</p>
      {%- endif -%}
    {%- else -%}
      <p class="purelane-empty">Add combo cards in the theme editor and pick the products that belong in each box.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Purelane Combos",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Pre-built to save you money"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Best selling combos"
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Lede description",
      "default": "Swipe through the boxes people order most. Each one is already priced below buying the same products on their own."
    },
    {
      "type": "text",
      "id": "fine_print",
      "label": "Price footnote",
      "default": "Inclusive of all taxes · COD available"
    },
    {
      "type": "text",
      "id": "railnote",
      "label": "Bottom footnote",
      "default": "Shop bundle adds these products to your cart. You can still change quantities before you pay."
    }
  ],
  "blocks": [
    {
      "type": "combo",
      "name": "Combo Card",
      "settings": [
        {
          "type": "checkbox",
          "id": "is_hero",
          "label": "Highlight as hero combo",
          "default": false
        },
        {
          "type": "text",
          "id": "title",
          "label": "Combo title",
          "default": "Kitchen essentials"
        },
        {
          "type": "text",
          "id": "flag",
          "label": "Optional flag",
          "info": "e.g. Most popular, Best value"
        },
        {
          "type": "product_list",
          "id": "products",
          "label": "Products in this combo",
          "limit": 12
        },
        {
          "type": "text",
          "id": "bundle_price",
          "label": "Sale price override",
          "info": "Optional. Leave blank to charge the live sum of the selected products. Enter a number in the store currency, e.g. 499."
        },
        {
          "type": "text",
          "id": "save_badge",
          "label": "Savings badge override"
        },
        {
          "type": "textarea",
          "id": "includes_text",
          "label": "Includes description override",
          "info": "Leave blank to list the selected product titles."
        },
        {
          "type": "text",
          "id": "button_url",
          "label": "Fallback link",
          "info": "Used only when none of the selected products can be added to cart."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Combos",
      "blocks": [
        {
          "type": "combo",
          "settings": {
            "title": "Kitchen essentials",
            "flag": "Most popular"
          }
        }
      ]
    }
  ]
}
{% endschema %}
