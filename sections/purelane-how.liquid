<!-- ================= PILLARS ================= -->
<section class="sec" id="how" data-scene="2">
  <div class="wrap">
    <div class="pillars">
      {%- for block in section.blocks -%}
        <article class="glass pillar rv {{ block.settings.delay_class }}" {{ block.shopify_attributes }}>
          <span class="pi">
            {%- if block.settings.icon_type == 'bubbles' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="8" cy="8.5" r="3.2"/><circle cx="16.4" cy="6.6" r="2.2"/><circle cx="15" cy="13" r="2.8"/><circle cx="8.6" cy="15.6" r="2.1"/><path d="M4 21h16"/></svg>
            {%- elsif block.settings.icon_type == 'shield' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/><path d="m9 12 2.2 2.2L15.4 10"/></svg>
            {%- else -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20s-7-4.4-7-9.4A4.1 4.1 0 0 1 12 8a4.1 4.1 0 0 1 7 2.6c0 5-7 9.4-7 9.4Z"/></svg>
            {%- endif -%}
          </span>
          <h3 class="d3">{{ block.settings.title }}</h3>
          <p class="body-s">{{ block.settings.description }}</p>
          <a class="btn btn-ghost btn-sm" href="{{ block.settings.button_url | default: '#shop' }}">
            {{ block.settings.button_text | default: 'Learn more' }}
          </a>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane How It Works",
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar Card",
      "settings": [
        {
          "type": "select",
          "id": "icon_type",
          "label": "Icon",
          "options": [
            { "value": "bubbles", "label": "Foaming Bubbles" },
            { "value": "shield", "label": "Clean Shield" },
            { "value": "heart", "label": "Safe Heart" }
          ],
          "default": "bubbles"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Pillar Title",
          "default": "Less scrubbing"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "A foaming formulation. The foam clings to grease and lifts it, so you wipe instead of scrub."
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text",
          "default": "Learn more"
        },
        {
          "type": "text",
          "id": "button_url",
          "label": "Button Link"
        },
        {
          "type": "text",
          "id": "delay_class",
          "label": "Delay Class",
          "default": ""
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane How It Works",
      "blocks": [
        {
          "type": "pillar",
          "settings": {
            "icon_type": "bubbles",
            "title": "Less scrubbing",
            "description": "A foaming formulation. The foam clings to grease and lifts it, so you wipe instead of scrub.",
            "button_text": "Learn more",
            "delay_class": ""
          }
        },
        {
          "type": "pillar",
          "settings": {
            "icon_type": "shield",
            "title": "Clean ingredients",
            "description": "No sulphates, no chlorine, no synthetic fragrance. Nothing on the label you would not want near your food.",
            "button_text": "Learn more",
            "delay_class": "rv-d2"
          }
        },
        {
          "type": "pillar",
          "settings": {
            "icon_type": "heart",
            "title": "Safe around everyone",
            "description": "Gentle on hands, safe around kids and pets, and it leaves no toxic residue on the surfaces you touch every day.",
            "button_text": "Learn more",
            "delay_class": "rv-d3"
          }
        }
      ]
    }
  ]
}
{% endschema %}
