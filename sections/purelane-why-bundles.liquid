<!-- ================= WHY BUNDLES BEAT BUYING SINGLE ================= -->
<section class="sec" id="whybundles" data-scene="4">
  <div class="wrap">
    <div class="glass sec-pad rv">
      <div class="panel-head">
        <span class="kicker">{{ section.settings.kicker | default: 'The smarter way to shop' }}</span>
        <h2 class="d2" style="margin-top:12px">{{ section.settings.heading | default: 'Why bundles beat buying single' }}</h2>
      </div>
      <div class="wb">
        <div class="wb-i">
          <span class="ci">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v18"/><path d="M16.5 7.2C15.6 6 14 5.4 12 5.4c-2.4 0-4 1.1-4 2.9 0 2 1.7 2.7 4.2 3.3 2.7.6 4.3 1.4 4.3 3.4 0 1.9-1.7 3.1-4.5 3.1-2.2 0-3.8-.7-4.8-2"/></svg>
          </span>
          <h4>{{ section.settings.b1_title | default: 'Save up to 45%' }}</h4>
          <p>{{ section.settings.b1_desc | default: 'Versus buying the same products separately' }}</p>
        </div>

        <div class="wb-i">
          <span class="ci">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="3.4"/><path d="m8.4 12.2 2.4 2.4 4.8-5"/></svg>
          </span>
          <h4>{{ section.settings.b2_title | default: 'One flat price' }}</h4>
          <p>{{ section.settings.b2_desc | default: 'No calculators, no comparing carts' }}</p>
        </div>

        <div class="wb-i">
          <span class="ci">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 3.6 2.6 5.3 5.8.8-4.2 4.1 1 5.8-5.2-2.8-5.2 2.8 1-5.8L3.6 9.7l5.8-.8Z"/></svg>
          </span>
          <h4>{{ section.settings.b3_title | default: 'Curated by experts' }}</h4>
          <p>{{ section.settings.b3_desc | default: 'Products picked to work well together' }}</p>
        </div>

        <div class="wb-i">
          <span class="ci">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.6 16.4V7.2h10.2v9.2"/><path d="M12.8 10.4h4l3.6 3.2v2.8h-7.6"/><circle cx="6.6" cy="18" r="1.9"/><circle cx="16.6" cy="18" r="1.9"/></svg>
          </span>
          <h4>{{ section.settings.b4_title | default: 'Free shipping always' }}</h4>
          <p>{{ section.settings.b4_desc | default: 'Included on every bundle, all India' }}</p>
        </div>
      </div>
    </div>
  </div>
</section>

