<section class="sec revband" id="reviews" data-scene="1">
  <div class="wrap">
    <div class="revhead rv">
      <span class="kicker">{{ section.settings.kicker | default: "That's what they said" }}</span>
      <span class="agg">
        <span class="st" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span> 
        <b>{{ section.settings.rating | default: "4.8" }}</b> {{ section.settings.reviews_label | default: "from 8,000+ reviews" }}
      </span>
      <span class="agg">{{ section.settings.social_proof | default: "Loved by <b>12 lakh+</b> homes" }}</span>
    </div>
  </div>

  <div class="revrail rv" aria-label="Customer reviews">
    <div class="revtrack">
      {%- comment -%}Render cards twice for smooth continuous marquee loop{%- endcomment -%}
      {%- for i in (1..2) -%}
        {%- for block in section.blocks -%}
          <article class="glass-2 rcard" {{ block.shopify_attributes }}>
            <div class="st" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
            <h5>{{ block.settings.title }}</h5>
            <p>{{ block.settings.quote }}</p>
            <div class="who">
              {%- if block.settings.verified -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m5 13 4 4L19 7"/>
                </svg>
              {%- endif -%}
              <b>{{ block.settings.author }}</b>
              {%- if block.settings.product_tag != blank -%}
                <span>&middot; {{ block.settings.product_tag }}</span>
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Reviews Rail",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "That's what they said"
    },
    {
      "type": "text",
      "id": "rating",
      "label": "Average Rating",
      "default": "4.8"
    },
    {
      "type": "text",
      "id": "reviews_label",
      "label": "Reviews Subtitle",
      "default": "from 8,000+ reviews"
    },
    {
      "type": "text",
      "id": "social_proof",
      "label": "Social Proof Text",
      "default": "Loved by <b>12 lakh+</b> homes"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review Card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Review Headline",
          "default": "Works like a charm"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Review Quote",
          "default": "Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author Name",
          "default": "Anita"
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Verified Buyer Badge",
          "default": true
        },
        {
          "type": "text",
          "id": "product_tag",
          "label": "Purchased Product Tag",
          "default": "Laundry detergent"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Reviews Rail",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "title": "Works like a charm",
