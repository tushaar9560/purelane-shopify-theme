<!-- ================= FIND THE RIGHT BUNDLE ================= -->
<section class="sec" id="categories" data-scene="4">
  <div class="wrap">
    <div class="panel-head rv">
      <span class="kicker">{{ section.settings.kicker | default: 'Bundle categories' }}</span>
      <h2 class="d2" style="margin-top:12px">{{ section.settings.heading | default: 'Find the right bundle for you' }}</h2>
    </div>
    <div class="cats">
      <a class="glass cat rv" href="{{ section.settings.cat1_url | default: '#combos' }}">
        <span class="ph"><span class="pimg p-kitchen" role="img" aria-label="Kitchen cleaner"></span></span>
        <span class="txt">
          <h4>{{ section.settings.cat1_title | default: 'Kitchen bundle' }}</h4>
          <p>{{ section.settings.cat1_desc | default: 'Grease, dishes & more' }}</p>
        </span>
      </a>
      <a class="glass cat rv rv-d1" href="{{ section.settings.cat2_url | default: '#combos' }}">
        <span class="ph"><span class="pimg p-toilet" role="img" aria-label="Toilet cleaner"></span></span>
        <span class="txt">
          <h4>{{ section.settings.cat2_title | default: 'Bathroom bundle' }}</h4>
          <p>{{ section.settings.cat2_desc | default: 'Deep clean & disinfect' }}</p>
        </span>
      </a>
      <a class="glass cat rv rv-d2" href="{{ section.settings.cat3_url | default: '#combos' }}">
        <span class="ph"><span class="pimg p-laundry" role="img" aria-label="Laundry detergent"></span></span>
        <span class="txt">
          <h4>{{ section.settings.cat3_title | default: 'Laundry bundle' }}</h4>
          <p>{{ section.settings.cat3_desc | default: 'Softer, fresher wash' }}</p>
        </span>
      </a>
      <a class="glass cat rv rv-d3" href="{{ section.settings.cat4_url | default: '#combos' }}">
        <span class="ph"><span class="pimg p-tap" role="img" aria-label="Tap cleaner"></span></span>
        <span class="txt">
          <h4>{{ section.settings.cat4_title | default: 'Hard water bundle' }}</h4>
          <p>{{ section.settings.cat4_desc | default: 'Melt away limescale' }}</p>
        </span>
      </a>
    </div>
  </div>
</section>

