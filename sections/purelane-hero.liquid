<section class="hero" data-scene="1" id="PurelaneHero-{{ section.id }}">
  <div class="hero-grid">

    <!-- Desktop Product Promises Badge Rail -->
    <div class="badges glass-2" aria-label="Product promises">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'promise' -%}
            <div class="badge" {{ block.shopify_attributes }}>
              <span class="bi">
                {%- if block.settings.icon == 'leaf' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
                {%- elsif block.settings.icon == 'shield' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/><path d="m9 12 2.2 2.2L15.4 10"/></svg>
                {%- else -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.4"/><path d="M6.4 17.6 17.6 6.4"/></svg>
                {%- endif -%}
              </span>
              <span>{{ block.settings.title | newline_to_br }}</span>
            </div>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        <div class="badge"><span class="bi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg></span><span>Plant<br>powered</span></div>
        <div class="badge"><span class="bi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/><path d="m9 12 2.2 2.2L15.4 10"/></svg></span><span>Kids &amp;<br>pet safe</span></div>
        <div class="badge"><span class="bi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.4"/><path d="M6.4 17.6 17.6 6.4"/></svg></span><span>Zero harsh<br>chem</span></div>
      {%- endif -%}
    </div>

    <!-- Hero Copy -->
    <div class="hero-copy">
      {%- if section.settings.kicker != blank -%}
        <span class="kicker rv">{{ section.settings.kicker }}</span>
      {%- endif -%}
      <h1 class="d1 rv rv-d1">
        {{ section.settings.heading | newline_to_br }}
        {%- if section.settings.heading_accent != blank -%}
          <span class="lime">{{ section.settings.heading_accent }}</span>
        {%- endif -%}
      </h1>

      <div class="rule rv rv-d2">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
        </svg>
        <i></i>
      </div>

      <p class="lede rv rv-d2">{{ section.settings.lede }}</p>

      <div class="hero-cta rv rv-d3">
        {%- if section.settings.primary_cta_label != blank -%}
          <a class="btn btn-primary" href="{{ section.settings.primary_cta_url | default: '#shop' }}">
            {{ section.settings.primary_cta_label }}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h13m-5-6 6 6-6 6"/>
            </svg>
          </a>
        {%- endif -%}

        {%- if section.settings.ghost_cta_label != blank -%}
          <a class="btn btn-ghost" href="{{ section.settings.ghost_cta_url | default: '#how' }}">
            {{ section.settings.ghost_cta_label }}
          </a>
        {%- endif -%}
      </div>

      <!-- Mobile Badge Strip -->
      <div class="badgestrip rv rv-d4">
        {%- for block in section.blocks -%}
          {%- if block.type == 'promise' -%}
            <div class="glass-2" {{ block.shopify_attributes }}>
              {%- if block.settings.icon == 'leaf' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
              {%- elsif block.settings.icon == 'shield' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/><path d="m9 12 2.2 2.2L15.4 10"/></svg>
              {%- else -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.4"/><path d="M6.4 17.6 17.6 6.4"/></svg>
              {%- endif -%}
              {{ block.settings.title | replace: '<br>', ' ' }}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    <!-- Interactive Hero Product Stage -->
    <div class="hero-prod" id="heroProd">
      <div class="hstage" id="hstage">
        <div class="hslide hs1 on" data-n="1">
          <span class="hp p-kbtl a d1" role="img" aria-label="Purelane foaming kitchen cleaner spray bottle"></span>
          <div class="glass-2 ptag">
            <span class="lbl">{{ section.settings.slide1_label | default: 'Single bottle' }}</span>
            <span class="val"><strong>{{ section.settings.slide1_price | default: '₹200' }}</strong><s>{{ section.settings.slide1_compare | default: '₹299' }}</s></span>
            <span class="cut">{{ section.settings.slide1_badge | default: '33% off' }}</span>
          </div>
        </div>
        <div class="hslide hs2" data-n="2">
          <span class="hp p-tbtl a d1" role="img" aria-label="Purelane tap cleaner and limescale remover spray bottle"></span>
          <span class="hp p-kbtl b d2" role="img" aria-label="Purelane foaming kitchen cleaner spray bottle"></span>
          <div class="glass-2 ptag">
            <span class="lbl">{{ section.settings.slide2_label | default: 'Any 2 products' }}</span>
            <span class="val"><strong>{{ section.settings.slide2_price | default: '₹349' }}</strong><s>{{ section.settings.slide2_compare | default: '₹598' }}</s></span>
            <span class="cut">{{ section.settings.slide2_badge | default: 'Save ₹249' }}</span>
          </div>
        </div>
        <div class="hslide hs3" data-n="3">
          <span class="hp p-tbtl a d1" role="img" aria-label="Purelane tap cleaner and limescale remover spray bottle"></span>
          <span class="hp p-mbtl b d2" role="img" aria-label="Purelane copper, bronze and brass cleaner pump bottle"></span>
          <span class="hp p-kbtl c d3" role="img" aria-label="Purelane foaming kitchen cleaner spray bottle"></span>
          <div class="glass-2 ptag">
            <span class="lbl">{{ section.settings.slide3_label | default: 'Any 3 products' }}</span>
            <span class="val"><strong>{{ section.settings.slide3_price | default: '₹499' }}</strong><s>{{ section.settings.slide3_compare | default: '₹897' }}</s></span>
            <span class="cut">{{ section.settings.slide3_badge | default: 'Save ₹398' }}</span>
          </div>
        </div>
      </div>
      <div class="hdots" id="hdots">
        <button type="button" class="on" aria-label="Show 1 product"></button>
        <button type="button" class="" aria-label="Show 2 products"></button>
        <button type="button" class="" aria-label="Show 3 products"></button>
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Purelane Hero",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker Eyebrow",
      "default": ""
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Headline",
      "default": "Clean That"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Headline Accent (Lime)",
      "default": "Lasts"
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Lede description",
      "default": "Homecare that works on the toughest grime, made from plants. Kind to your home, your family and the world outside it."
    },
    {
      "type": "text",
      "id": "primary_cta_label",
      "label": "Primary Button Label",
      "default": "Shop now"
    },
    {
      "type": "text",
      "id": "primary_cta_url",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "ghost_cta_label",
      "label": "Ghost Button Label",
      "default": "How it works"
    },
    {
      "type": "text",
      "id": "ghost_cta_url",
      "label": "Ghost Button Link"
    },
    {
      "type": "header",
      "content": "Hero Showcase Slide 1"
    },
    {
      "type": "text",
      "id": "slide1_label",
      "label": "Slide 1 Label",
      "default": "Single bottle"
    },
    {
      "type": "text",
      "id": "slide1_price",
      "label": "Slide 1 Price",
      "default": "₹200"
    },
    {
      "type": "text",
      "id": "slide1_compare",
      "label": "Slide 1 Compare Price",
      "default": "₹299"
    },
    {
      "type": "text",
      "id": "slide1_badge",
      "label": "Slide 1 Discount Badge",
      "default": "33% off"
    },
    {
      "type": "header",
      "content": "Hero Showcase Slide 2"
    },
    {
      "type": "text",
      "id": "slide2_label",
      "label": "Slide 2 Label",
      "default": "Any 2 products"
    },
    {
      "type": "text",
      "id": "slide2_price",
      "label": "Slide 2 Price",
      "default": "₹349"
    },
    {
      "type": "text",
      "id": "slide2_compare",
      "label": "Slide 2 Compare Price",
      "default": "₹598"
    },
    {
      "type": "text",
      "id": "slide2_badge",
      "label": "Slide 2 Discount Badge",
      "default": "Save ₹249"
    },
    {
      "type": "header",
      "content": "Hero Showcase Slide 3"
    },
    {
      "type": "text",
      "id": "slide3_label",
      "label": "Slide 3 Label",
      "default": "Any 3 products"
    },
    {
      "type": "text",
      "id": "slide3_price",
      "label": "Slide 3 Price",
      "default": "₹499"
    },
    {
      "type": "text",
      "id": "slide3_compare",
      "label": "Slide 3 Compare Price",
      "default": "₹897"
    },
    {
      "type": "text",
      "id": "slide3_badge",
      "label": "Slide 3 Discount Badge",
      "default": "Save ₹398"
    }
  ],
  "blocks": [
    {
      "type": "promise",
      "name": "Product Promise",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "leaf", "label": "Leaf" },
            { "value": "shield", "label": "Shield" },
            { "value": "chemical", "label": "Zero Harsh Chem" }
          ],
          "default": "leaf"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Plant powered"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Hero",
      "blocks": [
        { "type": "promise", "settings": { "icon": "leaf", "title": "Plant powered" } },
        { "type": "promise", "settings": { "icon": "shield", "title": "Kids & pet safe" } },
        { "type": "promise", "settings": { "icon": "chemical", "title": "Zero harsh chem" } }
      ]
    }
  ]
}
{% endschema %}
